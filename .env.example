# Copy to `.env` to override the defaults. Docker Compose reads this file automatically for
# variable substitution; the application reads it when started locally (outside Docker).

# Database credentials (used by the PostgreSQL container and by the application).
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
POSTGRES_DB=shop

# Where the application connects when it runs locally, outside Docker: the database container
# is published on localhost:${DB_HOST_PORT}. (Inside Docker the host is always `db:5432`.)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Host ports published by docker compose.
DB_HOST_PORT=5433
API_HOST_PORT=8000

LOG_LEVEL=INFO